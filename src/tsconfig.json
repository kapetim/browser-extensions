{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["chrome", "node"]
  },
  "include": ["chrome/**/*.ts", "lib/**/*.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "assets"]
}
