{
  "name": "browser-extensions",
  "version": "1.0.0",
  "description": "Browser tools \u2014 shared lib + chrome/firefox adapters.",
  "private": true,
  "scripts": {
    "build": "vite build && cp chrome/manifest.json dist/manifest.json && mkdir -p dist/icons && cp assets/src/img/icons/*.png dist/icons/",
    "setup:browser": "npm run build && node chrome/dev/setup-browser.mjs",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint --config ../scripts/eslint.config.js .",
    "format": "prettier --config ../scripts/.prettierrc.json --ignore-path ../scripts/.prettierignore . --write",
    "format:local": "npm run format && eslint --config ../scripts/eslint.config.js . --fix",
    "format:check": "prettier --config ../scripts/.prettierrc.json --ignore-path ../scripts/.prettierignore . --check",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "keywords": [
    "browser-extension",
    "recorder",
    "network"
  ],
  "author": "",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.1.38",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.2"
  }
}
